{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "helloyoulabs",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Admin (mini CRM): the account with this email, after entering the setup
  // code once. Only the code's SHA-256 is stored here; the code is shared
  // privately with the owner.
  "vars": {
    "ADMIN_EMAIL": "helloyouwellnessclinic@gmail.com",
    "ADMIN_CLAIM_SHA256": "51a523dfe2c5c1a783591a019c3ec67d4a4c50e8a331470614d804d27569d64a"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Every request runs the Worker first so pages can require sign-in.
    "run_worker_first": true
  },
  // Customer accounts. No database_id: `wrangler deploy` creates the database
  // on first deploy, and the Worker creates its tables on first request.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helloyoulabs-accounts"
    }
  ]
}
